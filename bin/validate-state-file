#!/usr/bin/env python3
"""Validate a disciplined-build workflow state file (.workflow/<slug>.md).

Deterministic, standalone, no LLM, no network. Python 3.8+ stdlib only.

Usage:
    validate-state-file <file>      validate a state file
    validate-state-file -           read state-file text from stdin

Exit codes:
    0  state file is valid (prints "PASS")
    1  violations found (each printed as "VIOLATION: ...")
    2  usage error / unreadable file
"""

import re
import sys

VALID_STATUSES = ("todo", "in progress", "done", "skipped")

TABLE_HEADER = re.compile(
    r"^\|\s*#\s*\|\s*Step\s*\|\s*Status\s*\|\s*Artifact\s*\|\s*$", re.I
)
SEPARATOR_ROW = re.compile(r"^\|[\s\-:|]+\|\s*$")


def parse_step_table(lines):
    """Return list of (step_no, step, status, artifact) tuples, or None if
    no step table is present."""
    rows = None
    in_table = False
    for line in lines:
        if not in_table:
            if TABLE_HEADER.match(line):
                in_table = True
                rows = []
            continue
        if SEPARATOR_ROW.match(line):
            continue
        if not line.lstrip().startswith("|"):
            break
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if len(cells) < 4:
            continue
        rows.append(tuple(cells[:4]))
    return rows


def extract_notes(lines):
    """Return the text under '## Notes' (up to the next heading), or None if
    the section is missing."""
    notes = None
    for line in lines:
        if notes is None:
            if re.match(r"^##\s+Notes\s*$", line):
                notes = []
            continue
        if line.startswith("#"):
            break
        notes.append(line)
    return None if notes is None else "\n".join(notes)


def notes_have_reason(notes):
    """A skip reason must be real content — not empty, not a leftover
    '<...>' template placeholder."""
    if notes is None:
        return False
    content = notes.strip()
    if not content:
        return False
    return not re.fullmatch(r"<[^>]*>", content)


def validate(text):
    """Validate state-file text; return a list of violation strings."""
    violations = []
    lines = text.splitlines()

    if not any(line.startswith("# Workflow:") for line in lines):
        violations.append("missing required section: '# Workflow:' header")
    if not re.search(r"^Started:\s*\S", text, re.M):
        violations.append("missing required field: 'Started:'")
    if not re.search(r"^Last updated:\s*\S", text, re.M):
        violations.append("missing required field: 'Last updated:'")

    rows = parse_step_table(lines)
    if rows is None:
        violations.append(
            "missing required section: step table "
            "(| # | Step | Status | Artifact |)"
        )
        rows = []

    notes = extract_notes(lines)
    if notes is None:
        violations.append("missing required section: '## Notes'")

    for step_no, step, status, artifact in rows:
        label = f"step {step_no} ({step})"
        if status not in VALID_STATUSES:
            violations.append(
                f"{label}: invalid status '{status}' "
                f"(expected one of: {', '.join(VALID_STATUSES)})"
            )
            continue
        if status == "done" and artifact in ("", "-"):
            violations.append(
                f"{label}: marked done but has no artifact — "
                "a checkmark with no artifact is a lie"
            )
        if status == "skipped" and not notes_have_reason(notes):
            violations.append(
                f"{label}: skipped but no reason recorded in '## Notes'"
            )

    return violations


def main(argv):
    if len(argv) != 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if argv[1] == "-":
        text = sys.stdin.read()
    else:
        try:
            with open(argv[1], encoding="utf-8") as f:
                text = f.read()
        except OSError as e:
            print(f"error: cannot read {argv[1]}: {e}", file=sys.stderr)
            return 2

    violations = validate(text)
    if violations:
        for v in violations:
            print(f"VIOLATION: {v}")
        print(f"\nFAIL: {len(violations)} violation(s)")
        return 1
    print("PASS")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
